# --- Server ---
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://techbloguser:Techblog2026@cluster0.gcdb9oo.mongodb.net/techblog?retryWrites=true&w=majority


# --- Auth (use a long random string in production) ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# --- URLs ---
# Comma-separated list of allowed front-end origins (dev only; same-origin in production)
CLIENT_URL=http://localhost:5173
# Public URL of the site, used in sitemap, canonical and Open Graph tags
SITE_URL=http://localhost:5000
SITE_NAME=TechPulse
SITE_DESCRIPTION=Technology insights, tutorials and company news on software, AI, cloud and security.

# --- First admin account (created by `npm run seed`) ---
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe@123

# --- Analytics / Search Console (optional) ---
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
